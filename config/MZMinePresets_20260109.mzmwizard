    <wiz_part part="MS" preset="QTOF">
        <parameter name="Ion mode">No filter</parameter>
        <parameter choices="ABSOLUTE_NOISE_LEVEL,FACTOR_OF_LOWEST_SIGNAL" ms1_level="500.0" msn_level="100.0" name="Noise threshold" selected_value="ABSOLUTE_NOISE_LEVEL"/>
